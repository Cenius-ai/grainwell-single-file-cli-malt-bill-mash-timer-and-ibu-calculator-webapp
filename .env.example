# Grainwell reads no configuration and no secrets - every input is a command
# line flag, and nothing is written to disk. The variables below are ordinary
# SHELL environment variables that only affect how output is drawn; they are
# listed here so the display behaviour is discoverable. An empty value is legal
# and means "use the app's own default".

# Set to any non-empty value to disable the colour swatch (the word descriptor
# and the sRGB hex are still printed).
NO_COLOR=

# Set to truecolor (or 24bit) to force the 24-bit swatch; any other value falls
# back to the 256-colour approximation when the terminal is a TTY.
COLORTERM=

# Terminal width used for the swatch band, e.g. 100.
COLUMNS=
